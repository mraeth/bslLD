    lines!(ax, d.t[2:end], floor_eps(faraday_residuals(d, dt_pk, grid_perp_kin) ./ δn0(d)); color=WONG[6+ci], linestyle=:dash, label="DKPolDensity kinetic β=$β: Faraday")
