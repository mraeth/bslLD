```julia; echo=false, results="hidden"
# ── Steppers ──────────────────────────────────────────────────────────────────
mutable struct Diag
    Ey::Vector; Bz::Vector; ni::Vector; t::Vector; qn::Vector
end
Diag() = Diag([], [], [], [], [])

function record!(diag::Diag, sol, ni, simTime; qn=NaN)
    push!(diag.Ey, copy(sol.E[2].data))
    push!(diag.Bz, copy(sol.B[3].data))
    push!(diag.ni, copy(ni.data))
    push!(diag.t,  simTime.current_T)
    push!(diag.qn, qn)
end

function step!(f_i, sol, grid, simTime, solver)
    phase_start = simTime.phase
    Ω  = bslLD.gyro_frequency(f_i, grid)
    dt = simTime.dt
    Pi_zero = bslLD.zero_vectorfield3(grid)

    simTime.fraction_dt = 0.5
    simTime.phase = phase_start + 0.25Ω*dt
    bslLD.advectV!(f_i, grid, simTime, sol.E)
    bslLD.advectX!(f_i, grid, simTime)

    simTime.phase = phase_start + 0.5Ω*dt
    n_i    = bslLD.compute_density(f_i, grid)
    J_perp = bslLD.compute_current(f_i, grid, simTime.phase)
    bslLD.solve_fields!(sol, bslLD.Moments(n_i, J_perp, Pi_zero), grid, solver, dt)

    simTime.phase = phase_start + 0.75Ω*dt
    bslLD.advectX!(f_i, grid, simTime)
    bslLD.advectV!(f_i, grid, simTime, sol.Enew)

    sol.E .= sol.Enew
    simTime.phase = phase_start; simTime.fraction_dt = 1.0
end

# X–C–X midpoint step. `coupling` sets the number of kinetic corrections of the stage current:
# :predictor_only 0, :moment_kinetic_corrector 1, :kinetic_picard until max|ΔEy| < picard_tol.
# damping_rate κ > 0 moves the stage to θ = 1/2 + κ dt.
function stepMidpoint!(f_i, sol, grid, simTime, solver;
                       coupling=:moment_kinetic_corrector, damping_rate=0.0,
                       picard_tol=1e-8, picard_maxiter=20)
    n_corr = coupling == :predictor_only           ? 0 :
             coupling == :moment_kinetic_corrector ? 1 :
             coupling == :kinetic_picard           ? picard_maxiter :
             throw(ArgumentError("unknown coupling $coupling"))
    phase_start = simTime.phase
    Ω  = bslLD.gyro_frequency(f_i, grid)
    dt = simTime.dt
    theta = 0.5 + damping_rate * dt
    @assert 0.5 <= theta <= 1.0
    Pi_zero = bslLD.zero_vectorfield3(grid)

    simTime.phase = phase_start + 0.25Ω*dt; simTime.fraction_dt = 0.5
    bslLD.advectX!(f_i, grid, simTime)
    f_a = copy(f_i.data)

    simTime.phase = phase_start + 0.5Ω*dt
    n_a = bslLD.compute_density(f_i, grid)
    # B is not modified by the stage solve; Faraday is applied once below.
    solve_stage(J) = (bslLD.solve_fields_damped_midpoint!(
        sol, bslLD.Moments(n_a, J, Pi_zero), grid, solver, dt, theta); sol.Enew)

    J_a   = bslLD.compute_current(f_i, grid, simTime.phase)
    E_mid = solve_stage(bslLD.predict_stage_current(n_a, J_a, sol.E, f_i, grid, dt, theta))
    for _ in 1:n_corr
        Ey_prev = copy(E_mid[2].data)
        f_i.data .= f_a; simTime.fraction_dt = theta
        bslLD.advectV!(f_i, grid, simTime, E_mid)
        E_mid = solve_stage(bslLD.compute_current(f_i, grid, simTime.phase))
        maximum(abs.(E_mid[2].data .- Ey_prev)) < picard_tol && break
    end

    f_i.data .= f_a; simTime.fraction_dt = 1.0
    bslLD.advectV!(f_i, grid, simTime, E_mid)
    bslLD.apply_faraday!(sol.B, E_mid, grid, dt)

    simTime.phase = phase_start + 0.75Ω*dt; simTime.fraction_dt = 0.5
    bslLD.advectX!(f_i, grid, simTime)

    sol.E .= E_mid; simTime.phase = phase_start; simTime.fraction_dt = 1.0
end

# X–C–X step in charge form (EMSolverDKPolDensity) for state = (ions, electrons): kinetic or
# cold-fluid ions, cold drift-fluid electrons. damping_rate κ > 0 moves the stage to θ = 1/2 + κ dt.
stepQN!(state, sol, grid, simTime, solver; damping_rate=0.0) =
    bslLD.step_charge_form!(state, sol, grid, solver, simTime.dt; phase=simTime.phase, damping_rate)

# Cold drift-kinetic electrons of the polarisation-density model.
cold_electrons(grid, μ) = bslLD.ColdFluid(grid, bslLD.DriftFluid(); q=-1, m=μ)

# ── Simulation helpers ─────────────────────────────────────────────────────────
# Zero-mean random seed of amplitude ε in Ey (:Ey), Bz (:Bz) or the ion density (:n); returns (sol, δn).
function seed_fields(Nx, ε, seed)
    E = [zeros(Nx) for _ in 1:3]; B = [zeros(Nx) for _ in 1:3]
    s = ε .* randn(Nx); s .-= mean(s)
    seed == :Ey ? (E[2] .= s) : seed == :Bz ? (B[3] .= s) : nothing
    vf(c) = bslLD.VectorField([bslLD.ScalarField(x) for x in c])
    return bslLD.FieldSolution(vf(E), vf(B)), (seed == :n ? s : zeros(Nx))
end

# Maxwellian ions with density 1 + δn on the grid nodes; vnoise > 0 shifts each velocity node by a
# random amount up to vnoise.
maxwellian_ions(grid, T; vnoise=0.0, δn=zeros(length(grid.xaxes[1]))) = bslLD.Distribution(grid, 0.0,
    initFuncx = x -> 1.0 + δn[round(Int, x / grid.delta[1]) + 1],
    initFuncv = v -> exp(-(v + vnoise*rand())^2 / (2T)) / sqrt(2π*T))

# Ion moments (n_i, J_i) at gyro-phase φ; J = (J⊥₁, J⊥₂[, J∥]) as the field solvers expect.
ion_moments(f::bslLD.ColdIonFluid, grid, φ) = bslLD.compute_moments(f, grid)
ion_moments(f, grid, φ) = bslLD.Moments(bslLD.compute_density(f, grid), bslLD.compute_current(f, grid, φ))

# Quasineutral start. 1D, k ⊥ b̂: B_z in balance with the ions, with frozen-in electrons δN_e = δB_z
# (w = 0 unless the solver keeps the polarisation density). EMSolverDKPolDensity: δN_e of the
# electron fluid from quasineutrality.
function quasineutral_start!(sol, ions, el, grid, solver)
    w = solver isa bslLD.EMSolverDKPolDensity ? solver.w : 0.0
    m = ion_moments(ions, grid, 0.0)
    bslLD.spatial_ndims(grid) == 1 && grid.Bdir == 3 &&
        bslLD.quasineutral_B!(sol.B, m.rho, m.J, grid, bslLD.EMSolverDKPolDensity(solver.beta_i, solver.mu; w))
    el === nothing || bslLD.quasineutral_drift!((ions, el), sol.B, grid, solver)
end

# Kinetic ions (stepper(state, sol, grid, simTime, solver)) or, with stepper = bslLD.step_cold!, the
# cold-ion fluid. EMSolverDKPolDensity carries a cold electron fluid: state = (ions, electrons).
# seed_field = :n seeds the ion density and starts quasineutral.
function run_sim(β, μ, dt, Tmax, grid; stepper=stepMidpoint!, solver=bslLD.EMSolverDKNoPol(β, μ),
                 ε=1e-4, T=1.0, seed=42, seed_field=:Bz, vnoise=0.0)
    Random.seed!(seed)
    sol, δn = seed_fields(length(grid.xaxes[1]), ε, seed_field)
    if stepper === bslLD.step_cold!
        ions = bslLD.ColdIonFluid(grid); Ω = grid.b0
        ions.delta_n.data .= δn
        density = s -> s.delta_n
    else
        ions = maxwellian_ions(grid, T; vnoise, δn); Ω = bslLD.gyro_frequency(ions, grid)
        density = s -> bslLD.compute_density(s, grid)
    end
    el = solver isa bslLD.EMSolverDKPolDensity ? cold_electrons(grid, μ) : nothing
    el !== nothing && stepper === bslLD.step_cold! && (stepper = stepQN!)
    seed_field == :n && quasineutral_start!(sol, ions, el, grid, solver)
    state = el === nothing ? ions : (ions, el)
    simTime = bslLD.SimulationTime(dt, Tmax)
    diag = Diag()
    while bslLD.continue_advection(simTime, true)
        stepper(state, sol, grid, simTime, solver)
        bslLD.advance!(simTime, Ω)
        qn = el === nothing ? NaN : bslLD.quasineutrality_residual(state, sol.B, grid, solver; phase=simTime.phase)
        record!(diag, sol, density(ions), simTime; qn)
    end
    return diag
end

mean_sq(diag, field) = [mean(abs2, x) for x in getfield(diag, field)]

# ‖Bz^n − Bz^{n−1} + dt ∂_{x1} Ey^n‖∞ per step; record! stores the stage field E^m of step n at index n.
function faraday_residuals(diag, dt, grid)
    k1 = fftfreq(length(grid.xaxes[1]), 1/grid.delta[1]) .* 2π
    return [maximum(abs.(diag.Bz[n] .- diag.Bz[n-1] .+ dt .* real.(ifft(im .* k1 .* fft(diag.Ey[n])))))
            for n in 2:length(diag.t)]
end

# ── Spectral helpers ───────────────────────────────────────────────────────────
function make_spec(diag, dt, grid; field=:Bz)
    Nx = length(grid.xaxes[1])
    ω  = fftfreq(length(diag.t), 1/dt) .* 2π
    k  = fftfreq(Nx, 1/grid.delta[1]) .* 2π
    nw = length(diag.t) ÷ 2
    nk = Nx ÷ 2
    data = transpose(hcat(getfield(diag, field)...))
    spec = log.(abs.(fft(data .* kaiser(length(diag.t), 3)))[1:nw, 1:nk] .+ 1e-30)
    return k[2:nk], ω[2:nw], spec[2:nw, 2:end]
end

function plot_spectrum!(ax, diag, dt, grid; field=:Bz)
    k, ω, spec = make_spec(diag, dt, grid; field)
    heatmap!(ax, k, ω, spec'; colormap=:inferno)
end
```

```julia; echo=false, results="hidden"
# ── Analytic references (KineticDR) ────────────────────────────────────────────
# In the 1D runs E∥ ≡ 0 (k ∥ b̂ or k ⊥ b̂), so the modes are the roots of the perpendicular 2×2 block of 𝒟.
# Electrons: massless Hall response (drift-kinetic, T_e → 0); μ does not enter that block.
# pol = true adds the full electron polarisation (E2, `EMSolverDKPol`).
darwin_model(β, μ, ions; pol=false) = KDR.Model(
    (KDR.Species(response = ions),
     KDR.Species(q = -1, m = μ, T = 1e-10, response = KDR.DriftKinetic(polarization = pol))),
    KDR.Darwin(beta = β))

kvec(k, dir) = dir == :par ? KDR.Wavevector(ky = 0.0, kz = k) : KDR.Wavevector(kx = k, ky = 0.0)

# 𝒟⊥(ω, k) of a KineticDR model, and of the polarisation-density model (`EMSolverDKPolDensity`):
# DK plus w μ (k⊥²/k²) k̂k̂ᵀ, which at k = k⊥ x̂ is w μ on the xx entry.
dperp(model::KDR.Model, dir) = (ω, k) -> KDR.dispersion_matrix(model, ω, kvec(k, dir))[1:2, 1:2]
dperp_poldensity(β, μ, ions; w=1.0) = (D = dperp(darwin_model(β, μ, ions), :perp);
                                       (ω, k) -> D(ω, k) + [w*μ 0; 0 0])

const HARMONIC_SEEDS = sort(vcat(0.1:0.2:8.0, [n + s*d for n in 1:8 for s in (-1, 1) for d in (0.3, 0.1, 0.03, 0.01, 3e-3, 1e-3, 3e-4, 1e-4)]))

# Roots ω (0.02 < Re ω < ωmax, |Im ω| < γmax) of det(ω² 𝒟⊥) at each k, from Muller seeds on re × im_seeds
# (dense on both sides of each harmonic, where the ion Bernstein roots crowd).
spectrum(model::KDR.Model, ks, dir; kw...) = spectrum(dperp(model, dir), ks; kw...)
function spectrum(D::Function, ks; re=HARMONIC_SEEDS, im_seeds=(0.0, -0.01), ωmax=8.0, γmax=0.5)
    out = Tuple{Float64,ComplexF64}[]
    for k in ks
        f(ω) = det(ω^2 .* D(ω, k))
        roots = ComplexF64[]
        for r in re, i in im_seeds
            # Muller's initial spread δ must not straddle the pole at the nearest harmonic
            ω, ok = KDR.find_root(f, complex(r, i); δ = clamp(abs(r - round(r)) / 10, 1e-6, 1e-3))
            ok && 0.02 < real(ω) < ωmax && abs(imag(ω)) < γmax && all(z -> abs(z - ω) > 1e-6, roots) && push!(roots, ω)
        end
        append!(out, ((k, ω) for ω in roots))
    end
    return out
end

function overlay!(ax, args...; color, label, kw...)
    s = spectrum(args...; kw...)
    scatter!(ax, first.(s), real.(last.(s)); color, label)
end
```

## Normalization

Frequencies are normalized to $\Omega_i = q_i B_0 / m_i$, lengths to $\rho_i = v_\mathrm{th}/\Omega_i$, and velocities to $v_\mathrm{th} = \sqrt{T_i/m_i}$. Susceptibilities are in units of $\omega_{pi}^2/\Omega_i^2$ (as in KineticDR).

| Symbol | Definition | Note |
|---|---|---|
| $\beta_i$ | $8\pi n_0 T_i / B_0^2$ | input |
| $\mu$ | $m_e/m_i$ | input; enters only the $E_\parallel$ equation through $\lambda$ |
| $2/\beta_i$ | $v_A^2/v_\mathrm{th}^2$ | coefficient of $\nabla\times\mathbf{B}$ in $\mathbf{E}_\perp$ |
| $d_i$ | $\sqrt{2/\beta_i}\,\rho_i$ | ion inertial length |
| $\zeta_n$ | $(\omega - n)/(\sqrt{2}\,k_\parallel)$ | cyclotron resonance argument |

## Electromagnetic Model

### Field equations

The ions obey the Vlasov equation in the total magnetic field $\mathbf{B}_\mathrm{tot} = B_0\hat{b} + \mathbf{B}$:
$$\frac{\partial f_i}{\partial t} + \mathbf{v}\cdot\nabla_x f_i + \left(\mathbf{E} + \mathbf{v}\times\mathbf{B}_\mathrm{tot}\right)\cdot\nabla_v f_i = 0.$$

Displacement current is neglected (Darwin approximation): $\nabla\times\mathbf{B} = \mu_0\mathbf{J}$. Together with Faraday's law and quasineutrality, the field equations are

$$\frac{\partial\mathbf{B}}{\partial t} = -\nabla\times\mathbf{E},$$

$$\mathbf{E}_\perp = \left(\frac{2}{\beta_i}\,\nabla\times\mathbf{B} - \mathbf{J}_{i\perp}\right)\times\hat{b},$$

$$\left(\nabla_\perp^2 - \lambda\right)E_\parallel - \nabla_\parallel\left(\nabla_\perp\cdot\mathbf{E}_\perp\right) = \frac{\beta_i}{2}\nabla\cdot\boldsymbol\Pi_\mathrm{diff}, \qquad \lambda = \frac{\beta_i}{2}\!\left(1 + \frac{1}{\mu}\right).$$

This is a quasineutral reduced model: $\nabla\cdot\mathbf{E}$ is not constrained by Gauss's law and can be nonzero, while $\partial_t(\nabla\cdot\mathbf{B}) = 0$, so an initially divergence-free magnetic field remains divergence-free. In all implemented integrators $\boldsymbol\Pi_\mathrm{diff} = 0$. In the 1D runs below $\mathbf{k}$ is either parallel or perpendicular to $\hat{b}$, so the coupling term vanishes and $E_\parallel \equiv 0$: neither $\lambda$ nor $\mu$ affects them.

### Model comparison

| Term | Full Maxwell | Darwin | DKNoPol | DKPol | DKPolDensity |
|---|---|---|---|---|---|
| $\varepsilon_0\partial_t\mathbf{E}$ (displacement current) | yes | no | no | no | no |
| Gauss / quasineutrality | Poisson | QN | QN (rate form, $\nabla\cdot\mathbf{J}=0$) | QN (rate form) | QN (charge form) |
| electron polarisation current $\mu\,\partial_t\mathbf{E}_\perp$ | — | — | no | yes (charge + transverse current) | charge only, weight $w$ |

**DKNoPol** solves the field equations above with $\boldsymbol\Pi_\mathrm{diff}=0$. In Fourier space a $3\times3$ linear system for $\hat{\mathbf{E}}$ is solved via Cramer's rule with $\alpha = 2\Delta t/\beta_i$ in the coupling matrix. **DKPol** adds the electron polarisation current $\mu\,\partial_t\mathbf{E}_\perp$ (both the curl-free and the transverse part), which enters as an implicit rotation with denominator $(1+\alpha'^2)$, $\alpha' = \Delta t/\mu$; it requires staggered-leapfrog $\mathbf{B}$. **DKPolDensity** keeps only the polarisation charge and imposes quasineutrality directly; see the last section.

### Electron and ion kinetics

The ion density and perpendicular current are the velocity moments of $f_i$:
$$n_i = \int f_i\,d\mathbf{v}, \qquad \mathbf{J}_{i\perp} = q_i\int\mathbf{v}_\perp f_i\,d\mathbf{v}.$$

Electrons are massless across the field: they carry only the Hall ($\mathbf{E}\times\mathbf{B}$) current, $\chi_H = 1/\omega$. Their parallel inertia enters only through $\lambda$.

## Cold Plasma Dispersion

### Dispersion matrix

The analytic references are computed with KineticDR: `dispersion_matrix` of a `Darwin(beta)` model, with `Cold()` or full-orbit (`GordeyevSeries()`) ions and massless electrons (`DriftKinetic()` at $T_e \to 0$, which leaves only the Hall term in the perpendicular block). Its dispersion matrix is
$$\mathcal{D}(\omega,\mathbf{k}) = \chi - \frac{2}{\beta_i}\frac{k^2}{\omega^2}\mathbf{P}_T, \qquad \mathbf{P}_T = \mathbf{I} - \hat{k}\hat{k},$$
where the Darwin term follows from Ampère's law without displacement current and Faraday's law, $\mathbf{k}\times(\mathbf{k}\times\hat{\mathbf{E}}) = -k^2\mathbf{P}_T\hat{\mathbf{E}}$. Since $E_\parallel \equiv 0$ in the simulations, the modes are the roots of $\det(\omega^2\mathcal{D}_\perp) = 0$, with $\mathcal{D}_\perp$ the perpendicular $2\times2$ block.

The cold susceptibility (for $\hat{b} = \hat{z}$) is

$$\chi_{\perp,\mathrm{cold}} = \begin{pmatrix} S & -iD \\ iD & S \end{pmatrix}, \qquad S = -\frac{1}{\omega^2-1}, \qquad D = \frac{1}{\omega(\omega^2-1)} + \frac{1}{\omega},$$

where the second term of $D$ is the electron Hall term.

**Parallel propagation** ($\mathbf{k} = k_\parallel\hat{b}$): $S \pm D = \frac{2}{\beta_i}\frac{k_\parallel^2}{\omega^2}$ gives the two circularly polarized branches (Alfvén/ion-cyclotron and whistler).

**Perpendicular propagation** ($\mathbf{k} = k_\perp\hat{x}$): $S\left(S - \frac{2}{\beta_i}\frac{k_\perp^2}{\omega^2}\right) - D^2 = 0$, the extraordinary (compressional) branch. The ordinary mode lives in $E_\parallel$ and is absent here.

```julia; echo=false, label="fig-cold-dispersion", fig_cap="Cold plasma dispersion of the Darwin model (KineticDR): roots of det(ω²𝒟⊥) for two β."

μ_ref = 0.1   # does not enter 𝒟⊥
kz_c  = range(0.02, 0.8, length=60)
kx_c  = range(0.05, 4.0, length=80)

fig = Figure(size=(1000, 420))
ax1 = Axis(fig[1,1], xlabel="k∥ ρᵢ", ylabel="ω/Ωᵢ", title="Parallel", limits=(nothing,(0,8)))
ax2 = Axis(fig[1,2], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", title="Perpendicular", limits=(nothing,(0,8)))
for (ci, β) in enumerate([0.05, 0.5])
    m = darwin_model(β, μ_ref, KDR.Cold())
    overlay!(ax1, m, kz_c, :par;  color=WONG[ci+1], label="β=$β")
    overlay!(ax2, m, kx_c, :perp; color=WONG[ci+1], label="β=$β")
end
axislegend(ax1; position=:lt)
axislegend(ax2; position=:lt)
fig
```

## Hot Ion Dispersion (DKNoPol)

### Ion susceptibility tensor

The hot ion susceptibility sums over cyclotron harmonics $n$ (KineticDR's `GordeyevSeries`, adaptive truncation):

$$b = k_\perp^2\rho_i^2, \qquad \Gamma_n(b) = e^{-b}I_{|n|}(b), \qquad \Gamma'_n(b) = e^{-b}\!\left[\tfrac{1}{2}(I_{|n|-1}+I_{|n|+1})-I_{|n|}\right],$$
$$\zeta_n = \frac{\omega - n\Omega_i}{\sqrt{2}\,k_\parallel v_{ti}}, \qquad \zeta_0 = \frac{\omega}{\sqrt{2}\,k_\parallel v_{ti}}.$$

$$\begin{aligned}
(\chi_i)_{xx} &= \frac{1}{\omega^2}\sum_n \frac{n^2}{b}\,\Gamma_n\,\zeta_0 Z(\zeta_n) \\
(\chi_i)_{xy} &= -(\chi_i)_{yx} = \frac{1}{\omega^2}\sum_n in\,\Gamma'_n\,\zeta_0 Z(\zeta_n) \\
(\chi_i)_{xz} &= (\chi_i)_{zx} = -\frac{1}{\omega^2}\sum_n \frac{n}{\sqrt{2b}}\,\Gamma_n\,\zeta_0 Z'(\zeta_n) \\
(\chi_i)_{yy} &= \frac{1}{\omega^2}\sum_n \!\left[\frac{n^2}{b}\Gamma_n - 2b\Gamma'_n\right]\zeta_0 Z(\zeta_n) \\
(\chi_i)_{yz} &= -(\chi_i)_{zy} = \frac{1}{\omega^2}\sum_n i\sqrt{\tfrac{b}{2}}\,\Gamma'_n\,\zeta_0 Z'(\zeta_n) \\
(\chi_i)_{zz} &= -\frac{1}{\omega^2}\sum_n \Gamma_n\,\zeta_0\zeta_n Z'(\zeta_n)
\end{aligned}$$

with $Z$ the plasma dispersion function. For $k_\parallel=0$, $\zeta_0 Z(\zeta_n)\to -\omega/(\omega-n)$ and the $xz,\,yz$ terms vanish. For $k_\perp \to 0$ only $n = 0, \pm 1$ survive, the latter through $n^2\Gamma_n/b \to \tfrac{1}{2}$.

### Full dispersion matrix

$$\mathcal{D}_\perp(\omega,\mathbf{k}) = \chi_{i\perp} + \begin{pmatrix} 0 & -i\chi_H \\ i\chi_H & 0 \end{pmatrix} - \frac{2}{\beta_i}\frac{k^2}{\omega^2}\mathbf{P}_{T\perp}, \qquad \det\left(\omega^2\mathcal{D}_\perp\right) = 0.$$

For **parallel propagation** ($k_\perp = 0$) the system splits into the two circular polarizations, $\chi_i^\pm = (\chi_i)_{xx} \pm i(\chi_i)_{xy}$:

$$\chi_i^\pm \pm \chi_H - \frac{2}{\beta_i}\frac{k_\parallel^2}{\omega^2} = 0.$$

For **perpendicular propagation** ($k_\parallel = 0$) the $2\times2$ block contains the electrostatic ion Bernstein modes and the compressional (extraordinary) branch.

```julia; echo=false, label="fig-hot-parallel", fig_cap="Parallel propagation hot dispersion (β=0.5). Cold reference: black. Hot roots colored by Re(ω)<1 (orange) / Re(ω)>1 (blue); roots with |Im ω| > 0.5 are not shown."

βi_h = 0.5
kz_vals = range(0.02, 3.0, length=50)
par_spectrum = spectrum(darwin_model(βi_h, μ_ref, KDR.GordeyevSeries()), kz_vals, :par; im_seeds=(-0.01, -0.1))
kpar_k = first.(par_spectrum); ωre = real.(last.(par_spectrum)); ωim = imag.(last.(par_spectrum))

fig = Figure(size=(800, 620))
ax1 = Axis(fig[1,1], xlabel="k∥ ρᵢ", ylabel="Re(ω)/Ωᵢ", limits=(nothing,(0,8)))
ax2 = Axis(fig[2,1], xlabel="k∥ ρᵢ", ylabel="Im(ω)/Ωᵢ")
overlay!(ax1, darwin_model(βi_h, μ_ref, KDR.Cold()), kz_vals, :par; color=:black, label="cold")
for (sel, c, l) in ((ωre .< 1.0, WONG[2], "Re(ω)<1"), (ωre .> 1.0, WONG[6], "Re(ω)>1"))
    scatter!(ax1, kpar_k[sel], ωre[sel]; color=c, label=l)
    scatter!(ax2, kpar_k[sel], ωim[sel]; color=c)
end
axislegend(ax1; position=:lt)
hlines!(ax2, [0.0]; color=:gray, linestyle=:dash)
linkxaxes!(ax1, ax2)
fig
```

```julia; echo=false, label="fig-hot-perp", fig_cap="Perpendicular propagation hot dispersion (β=0.5). Cold reference: black. Hot roots including ion Bernstein branches."

kx_vals = range(0.05, 4.0, length=75)
fig = Figure(size=(850, 480))
ax = Axis(fig[1,1], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", limits=(nothing,(0,8)))
overlay!(ax, darwin_model(βi_h, μ_ref, KDR.Cold()), kx_vals, :perp; color=:black, label="cold")
overlay!(ax, darwin_model(βi_h, μ_ref, KDR.GordeyevSeries()), kx_vals, :perp; color=WONG[3], label="hot")
axislegend(ax; position=:lt)
