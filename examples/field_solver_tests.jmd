```julia; echo=false, results="hidden"
# ── Steppers ──────────────────────────────────────────────────────────────────
mutable struct Diag
    Ey::Vector; Bz::Vector; ni::Vector; t::Vector
end
Diag() = Diag([], [], [], [])

function record!(diag::Diag, sol, ni, simTime)
    push!(diag.Ey, copy(sol.E[2].data))
    push!(diag.Bz, copy(sol.B[3].data))
    push!(diag.ni, copy(ni.data))
    push!(diag.t,  simTime.current_T)
end

function step!(f_i, sol, grid, simTime, solver)
    phase_start = simTime.phase
    Ω  = bslLD.gyro_frequency(f_i, grid)
    dt = simTime.dt
    Pi_zero = bslLD.zero_vectorfield3(grid)

    simTime.fraction_dt = 0.5
    simTime.phase = phase_start + 0.25Ω*dt
    bslLD.advectV!(f_i, grid, simTime, sol.E)
    bslLD.advectX!(f_i, grid, simTime)

    simTime.phase = phase_start + 0.5Ω*dt
    n_i    = bslLD.compute_density(f_i, grid)
    J_perp = bslLD.compute_current(f_i, grid, simTime.phase)
    bslLD.solve_fields!(sol, bslLD.Moments(n_i, J_perp, Pi_zero), grid, solver, dt)

    simTime.phase = phase_start + 0.75Ω*dt
    bslLD.advectX!(f_i, grid, simTime)
    bslLD.advectV!(f_i, grid, simTime, sol.Enew)

    sol.E .= sol.Enew
    simTime.phase = phase_start; simTime.fraction_dt = 1.0
end

# X–C–X midpoint step. `coupling` sets the number of kinetic corrections of the stage current:
# :predictor_only 0, :moment_kinetic_corrector 1, :kinetic_picard until max|ΔEy| < picard_tol.
# damping_rate κ > 0 moves the stage to θ = 1/2 + κ dt.
function stepMidpoint!(f_i, sol, grid, simTime, solver;
                       coupling=:moment_kinetic_corrector, damping_rate=0.0,
                       picard_tol=1e-8, picard_maxiter=20)
    n_corr = coupling == :predictor_only           ? 0 :
             coupling == :moment_kinetic_corrector ? 1 :
             coupling == :kinetic_picard           ? picard_maxiter :
             throw(ArgumentError("unknown coupling $coupling"))
    phase_start = simTime.phase
    Ω  = bslLD.gyro_frequency(f_i, grid)
    dt = simTime.dt
    theta = 0.5 + damping_rate * dt
    @assert 0.5 <= theta <= 1.0
    Pi_zero = bslLD.zero_vectorfield3(grid)

    simTime.phase = phase_start + 0.25Ω*dt; simTime.fraction_dt = 0.5
    bslLD.advectX!(f_i, grid, simTime)
    f_a = copy(f_i.data)

    simTime.phase = phase_start + 0.5Ω*dt
    n_a = bslLD.compute_density(f_i, grid)
    # B is not modified by the stage solve; Faraday is applied once below.
    solve_stage(J) = (bslLD.solve_fields_damped_midpoint!(
        sol, bslLD.Moments(n_a, J, Pi_zero), grid, solver, dt, theta); sol.Enew)

    J_a   = bslLD.compute_current(f_i, grid, simTime.phase)
    E_mid = solve_stage(bslLD.predict_stage_current(n_a, J_a, sol.E, f_i, grid, dt, theta))
    for _ in 1:n_corr
        Ey_prev = copy(E_mid[2].data)
        f_i.data .= f_a; simTime.fraction_dt = theta
        bslLD.advectV!(f_i, grid, simTime, E_mid)
        E_mid = solve_stage(bslLD.compute_current(f_i, grid, simTime.phase))
        maximum(abs.(E_mid[2].data .- Ey_prev)) < picard_tol && break
    end

    f_i.data .= f_a; simTime.fraction_dt = 1.0
    bslLD.advectV!(f_i, grid, simTime, E_mid)
    bslLD.apply_faraday!(sol.B, E_mid, grid, dt)

    simTime.phase = phase_start + 0.75Ω*dt; simTime.fraction_dt = 0.5
    bslLD.advectX!(f_i, grid, simTime)

    sol.E .= E_mid; simTime.phase = phase_start; simTime.fraction_dt = 1.0
end

# X–C–X step in charge form (EMSolverDKPolDensity): moment-implicit stage field, one kinetic
# corrector, then B_z^{n+1} from quasineutrality with the final ion moments.
function stepMidpointQN!(f_i, sol, grid, simTime, solver)
    phase_start = simTime.phase
    Ω  = bslLD.gyro_frequency(f_i, grid)
    dt = simTime.dt
    copy3(F) = bslLD.VectorField([copy(F[d].data) for d in 1:3])
    x_half!(φ) = (simTime.phase = phase_start + φ*Ω*dt; simTime.fraction_dt = 0.5;
                  bslLD.advectX!(f_i, grid, simTime))
    kick!(E) = (simTime.phase = phase_start + 0.5Ω*dt; simTime.fraction_dt = 1.0;
                bslLD.advectV!(f_i, grid, simTime, E))
    moments(φ) = bslLD.Moments(bslLD.compute_density(f_i, grid),
                               bslLD.compute_current(f_i, grid, phase_start + φ*Ω*dt))

    x_half!(0.25)
    f_a, m_a, B_n = copy(f_i.data), moments(0.5), copy3(sol.B)
    n0 = mean(m_a.rho.data) * bslLD.electric_acceleration_scale(f_i)
    bslLD.solve_fields_moment_implicit!(sol, m_a, grid, solver, dt; B_n, n0)

    E_p = copy3(sol.Enew)
    kick!(E_p); J_b = moments(0.5).J
    x_half!(0.75); m_1 = moments(1.0)
    bslLD.solve_fields_moment_implicit!(sol, m_a, grid, solver, dt; B_n, n0,
        corrector = (E = E_p, J_b = J_b, n_1 = m_1.rho, J_1 = m_1.J))

    f_i.data .= f_a
    kick!(sol.Enew); x_half!(0.75); m_1 = moments(1.0)
    bslLD.quasineutral_B!(sol.B, m_1.rho, m_1.J, grid, solver)
    sol.E .= sol.Enew; simTime.phase = phase_start; simTime.fraction_dt = 1.0
end

# ── Simulation helpers ─────────────────────────────────────────────────────────
# Zero-mean random seed of amplitude ε in Ey (:Ey), Bz (:Bz) or the ion density (:n); returns (sol, δn).
function seed_fields(Nx, ε, seed)
    E = [zeros(Nx) for _ in 1:3]; B = [zeros(Nx) for _ in 1:3]
    s = ε .* randn(Nx); s .-= mean(s)
    seed == :Ey ? (E[2] .= s) : seed == :Bz ? (B[3] .= s) : nothing
    vf(c) = bslLD.VectorField([bslLD.ScalarField(x) for x in c])
    return bslLD.FieldSolution(vf(E), vf(B)), (seed == :n ? s : zeros(Nx))
end

# Maxwellian ions with density 1 + δn on the grid nodes; vnoise > 0 shifts each velocity node by a
# random amount up to vnoise.
maxwellian_ions(grid, T; vnoise=0.0, δn=zeros(length(grid.xaxes[1]))) = bslLD.Distribution(grid, 0.0,
    initFuncx = x -> 1.0 + δn[round(Int, x / grid.delta[1]) + 1],
    initFuncv = v -> exp(-(v + vnoise*rand())^2 / (2T)) / sqrt(2π*T))

# B_z in quasineutral balance with the initial ions (w = 0 unless the solver keeps the polarisation density).
function quasineutral_start!(sol, state, grid, solver)
    w = solver isa bslLD.EMSolverDKPolDensity ? solver.w : 0.0
    m = state isa bslLD.ColdIonFluid ? bslLD.compute_moments(state, grid) :
        bslLD.Moments(bslLD.compute_density(state, grid), bslLD.compute_current(state, grid, 0.0))
    bslLD.quasineutral_B!(sol.B, m.rho, m.J, grid, bslLD.EMSolverDKPolDensity(solver.beta_i, solver.mu; w))
end

# Kinetic ions (stepper(f, sol, grid, simTime, solver)) or, with stepper = bslLD.step_cold!, the cold-ion fluid.
# seed_field = :n seeds the ion density and starts from a quasineutral B_z.
function run_sim(β, μ, dt, Tmax, grid; stepper=stepMidpoint!, solver=bslLD.EMSolverDKNoPol(β, μ),
                 ε=1e-4, T=1.0, seed=42, seed_field=:Bz, vnoise=0.0)
    Random.seed!(seed)
    sol, δn = seed_fields(length(grid.xaxes[1]), ε, seed_field)
    if stepper === bslLD.step_cold!
        state = bslLD.ColdIonFluid(grid); Ω = grid.b0
        state.delta_n.data .= δn
        density = s -> s.delta_n
    else
        state = maxwellian_ions(grid, T; vnoise, δn); Ω = bslLD.gyro_frequency(state, grid)
        density = s -> bslLD.compute_density(s, grid)
    end
    seed_field == :n && quasineutral_start!(sol, state, grid, solver)
    simTime = bslLD.SimulationTime(dt, Tmax)
    diag = Diag()
    while bslLD.continue_advection(simTime, true)
        stepper(state, sol, grid, simTime, solver)
        bslLD.advance!(simTime, Ω)
        record!(diag, sol, density(state), simTime)
    end
    return diag
end

mean_sq(diag, field) = [mean(abs2, x) for x in getfield(diag, field)]

# ‖Bz^n − Bz^{n−1} + dt ∂_{x1} Ey^n‖∞ per step; record! stores the stage field E^m of step n at index n.
function faraday_residuals(diag, dt, grid)
    k1 = fftfreq(length(grid.xaxes[1]), 1/grid.delta[1]) .* 2π
    return [maximum(abs.(diag.Bz[n] .- diag.Bz[n-1] .+ dt .* real.(ifft(im .* k1 .* fft(diag.Ey[n])))))
            for n in 2:length(diag.t)]
end

# ── Spectral helpers ───────────────────────────────────────────────────────────
function make_spec(diag, dt, grid; field=:Bz)
    Nx = length(grid.xaxes[1])
    ω  = fftfreq(length(diag.t), 1/dt) .* 2π
    k  = fftfreq(Nx, 1/grid.delta[1]) .* 2π
    nw = length(diag.t) ÷ 2
    nk = Nx ÷ 2
    data = transpose(hcat(getfield(diag, field)...))
    spec = log.(abs.(fft(data .* kaiser(length(diag.t), 3)))[1:nw, 1:nk] .+ 1e-30)
    return k[2:nk], ω[2:nw], spec[2:nw, 2:end]
end

function plot_spectrum!(ax, diag, dt, grid; field=:Bz)
    k, ω, spec = make_spec(diag, dt, grid; field)
    heatmap!(ax, k, ω, spec'; colormap=:inferno)
end
```

```julia; echo=false, results="hidden"
# ── Analytic references (KineticDR) ────────────────────────────────────────────
# In the 1D runs E∥ ≡ 0 (k ∥ b̂ or k ⊥ b̂), so the modes are the roots of the perpendicular 2×2 block of 𝒟.
# Electrons: massless Hall response (drift-kinetic, T_e → 0); μ does not enter that block.
# pol = true adds the full electron polarisation (E2, `EMSolverDKPol`).
darwin_model(β, μ, ions; pol=false) = KDR.Model(
    (KDR.Species(response = ions),
     KDR.Species(q = -1, m = μ, T = 1e-10, response = KDR.DriftKinetic(polarization = pol))),
    KDR.Darwin(beta = β))

kvec(k, dir) = dir == :par ? KDR.Wavevector(ky = 0.0, kz = k) : KDR.Wavevector(kx = k, ky = 0.0)

# 𝒟⊥(ω, k) of a KineticDR model, and of the polarisation-density model (`EMSolverDKPolDensity`):
# DK plus w μ (k⊥²/k²) k̂k̂ᵀ, which at k = k⊥ x̂ is w μ on the xx entry.
dperp(model::KDR.Model, dir) = (ω, k) -> KDR.dispersion_matrix(model, ω, kvec(k, dir))[1:2, 1:2]
dperp_poldensity(β, μ, ions; w=1.0) = (D = dperp(darwin_model(β, μ, ions), :perp);
                                       (ω, k) -> D(ω, k) + [w*μ 0; 0 0])

const HARMONIC_SEEDS = sort(vcat(0.1:0.2:8.0, [n + s*d for n in 1:8 for s in (-1, 1) for d in (0.3, 0.1, 0.03, 0.01, 3e-3, 1e-3, 3e-4, 1e-4)]))

# Roots ω (0.02 < Re ω < ωmax, |Im ω| < γmax) of det(ω² 𝒟⊥) at each k, from Muller seeds on re × im_seeds
# (dense on both sides of each harmonic, where the ion Bernstein roots crowd).
spectrum(model::KDR.Model, ks, dir; kw...) = spectrum(dperp(model, dir), ks; kw...)
function spectrum(D::Function, ks; re=HARMONIC_SEEDS, im_seeds=(0.0, -0.01), ωmax=8.0, γmax=0.5)
    out = Tuple{Float64,ComplexF64}[]
    for k in ks
        f(ω) = det(ω^2 .* D(ω, k))
        roots = ComplexF64[]
        for r in re, i in im_seeds
            # Muller's initial spread δ must not straddle the pole at the nearest harmonic
            ω, ok = KDR.find_root(f, complex(r, i); δ = clamp(abs(r - round(r)) / 10, 1e-6, 1e-3))
            ok && 0.02 < real(ω) < ωmax && abs(imag(ω)) < γmax && all(z -> abs(z - ω) > 1e-6, roots) && push!(roots, ω)
        end
        append!(out, ((k, ω) for ω in roots))
    end
    return out
end

function overlay!(ax, args...; color, label, kw...)
    s = spectrum(args...; kw...)
    scatter!(ax, first.(s), real.(last.(s)); color, label)
end
```

## Normalization

Frequencies are normalized to $\Omega_i = q_i B_0 / m_i$, lengths to $\rho_i = v_\mathrm{th}/\Omega_i$, and velocities to $v_\mathrm{th} = \sqrt{T_i/m_i}$. Susceptibilities are in units of $\omega_{pi}^2/\Omega_i^2$ (as in KineticDR).

| Symbol | Definition | Note |
|---|---|---|
| $\beta_i$ | $8\pi n_0 T_i / B_0^2$ | input |
| $\mu$ | $m_e/m_i$ | input; enters only the $E_\parallel$ equation through $\lambda$ |
| $2/\beta_i$ | $v_A^2/v_\mathrm{th}^2$ | coefficient of $\nabla\times\mathbf{B}$ in $\mathbf{E}_\perp$ |
| $d_i$ | $\sqrt{2/\beta_i}\,\rho_i$ | ion inertial length |
| $\zeta_n$ | $(\omega - n)/(\sqrt{2}\,k_\parallel)$ | cyclotron resonance argument |

## Electromagnetic Model

### Field equations

The ions obey the Vlasov equation in the total magnetic field $\mathbf{B}_\mathrm{tot} = B_0\hat{b} + \mathbf{B}$:
$$\frac{\partial f_i}{\partial t} + \mathbf{v}\cdot\nabla_x f_i + \left(\mathbf{E} + \mathbf{v}\times\mathbf{B}_\mathrm{tot}\right)\cdot\nabla_v f_i = 0.$$

Displacement current is neglected (Darwin approximation): $\nabla\times\mathbf{B} = \mu_0\mathbf{J}$. Together with Faraday's law and quasineutrality, the field equations are

$$\frac{\partial\mathbf{B}}{\partial t} = -\nabla\times\mathbf{E},$$

$$\mathbf{E}_\perp = \left(\frac{2}{\beta_i}\,\nabla\times\mathbf{B} - \mathbf{J}_{i\perp}\right)\times\hat{b},$$

$$\left(\nabla_\perp^2 - \lambda\right)E_\parallel - \nabla_\parallel\left(\nabla_\perp\cdot\mathbf{E}_\perp\right) = \frac{\beta_i}{2}\nabla\cdot\boldsymbol\Pi_\mathrm{diff}, \qquad \lambda = \frac{\beta_i}{2}\!\left(1 + \frac{1}{\mu}\right).$$

This is a quasineutral reduced model: $\nabla\cdot\mathbf{E}$ is not constrained by Gauss's law and can be nonzero, while $\partial_t(\nabla\cdot\mathbf{B}) = 0$, so an initially divergence-free magnetic field remains divergence-free. In all implemented integrators $\boldsymbol\Pi_\mathrm{diff} = 0$. In the 1D runs below $\mathbf{k}$ is either parallel or perpendicular to $\hat{b}$, so the coupling term vanishes and $E_\parallel \equiv 0$: neither $\lambda$ nor $\mu$ affects them.

### Model comparison

| Term | Full Maxwell | Darwin | DKNoPol | DKPol | DKPolDensity |
|---|---|---|---|---|---|
| $\varepsilon_0\partial_t\mathbf{E}$ (displacement current) | yes | no | no | no | no |
| Gauss / quasineutrality | Poisson | QN | QN (rate form, $\nabla\cdot\mathbf{J}=0$) | QN (rate form) | QN (charge form) |
| electron polarisation current $\mu\,\partial_t\mathbf{E}_\perp$ | — | — | no | yes (charge + transverse current) | charge only, weight $w$ |

**DKNoPol** solves the field equations above with $\boldsymbol\Pi_\mathrm{diff}=0$. In Fourier space a $3\times3$ linear system for $\hat{\mathbf{E}}$ is solved via Cramer's rule with $\alpha = 2\Delta t/\beta_i$ in the coupling matrix. **DKPol** adds the electron polarisation current $\mu\,\partial_t\mathbf{E}_\perp$ (both the curl-free and the transverse part), which enters as an implicit rotation with denominator $(1+\alpha'^2)$, $\alpha' = \Delta t/\mu$; it requires staggered-leapfrog $\mathbf{B}$. **DKPolDensity** keeps only the polarisation charge and imposes quasineutrality directly; see the last section.

### Electron and ion kinetics

The ion density and perpendicular current are the velocity moments of $f_i$:
$$n_i = \int f_i\,d\mathbf{v}, \qquad \mathbf{J}_{i\perp} = q_i\int\mathbf{v}_\perp f_i\,d\mathbf{v}.$$

Electrons are massless across the field: they carry only the Hall ($\mathbf{E}\times\mathbf{B}$) current, $\chi_H = 1/\omega$. Their parallel inertia enters only through $\lambda$.

## Cold Plasma Dispersion

### Dispersion matrix

The analytic references are computed with KineticDR: `dispersion_matrix` of a `Darwin(beta)` model, with `Cold()` or full-orbit (`GordeyevSeries()`) ions and massless electrons (`DriftKinetic()` at $T_e \to 0$, which leaves only the Hall term in the perpendicular block). Its dispersion matrix is
$$\mathcal{D}(\omega,\mathbf{k}) = \chi - \frac{2}{\beta_i}\frac{k^2}{\omega^2}\mathbf{P}_T, \qquad \mathbf{P}_T = \mathbf{I} - \hat{k}\hat{k},$$
where the Darwin term follows from Ampère's law without displacement current and Faraday's law, $\mathbf{k}\times(\mathbf{k}\times\hat{\mathbf{E}}) = -k^2\mathbf{P}_T\hat{\mathbf{E}}$. Since $E_\parallel \equiv 0$ in the simulations, the modes are the roots of $\det(\omega^2\mathcal{D}_\perp) = 0$, with $\mathcal{D}_\perp$ the perpendicular $2\times2$ block.

The cold susceptibility (for $\hat{b} = \hat{z}$) is

$$\chi_{\perp,\mathrm{cold}} = \begin{pmatrix} S & -iD \\ iD & S \end{pmatrix}, \qquad S = -\frac{1}{\omega^2-1}, \qquad D = \frac{1}{\omega(\omega^2-1)} + \frac{1}{\omega},$$

where the second term of $D$ is the electron Hall term.

**Parallel propagation** ($\mathbf{k} = k_\parallel\hat{b}$): $S \pm D = \frac{2}{\beta_i}\frac{k_\parallel^2}{\omega^2}$ gives the two circularly polarized branches (Alfvén/ion-cyclotron and whistler).

**Perpendicular propagation** ($\mathbf{k} = k_\perp\hat{x}$): $S\left(S - \frac{2}{\beta_i}\frac{k_\perp^2}{\omega^2}\right) - D^2 = 0$, the extraordinary (compressional) branch. The ordinary mode lives in $E_\parallel$ and is absent here.

```julia; echo=false, label="fig-cold-dispersion", fig_cap="Cold plasma dispersion of the Darwin model (KineticDR): roots of det(ω²𝒟⊥) for two β."

μ_ref = 0.1   # does not enter 𝒟⊥
kz_c  = range(0.02, 0.8, length=60)
kx_c  = range(0.05, 4.0, length=80)

fig = Figure(size=(1000, 420))
ax1 = Axis(fig[1,1], xlabel="k∥ ρᵢ", ylabel="ω/Ωᵢ", title="Parallel", limits=(nothing,(0,8)))
ax2 = Axis(fig[1,2], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", title="Perpendicular", limits=(nothing,(0,8)))
for (ci, β) in enumerate([0.05, 0.5])
    m = darwin_model(β, μ_ref, KDR.Cold())
    overlay!(ax1, m, kz_c, :par;  color=WONG[ci+1], label="β=$β")
    overlay!(ax2, m, kx_c, :perp; color=WONG[ci+1], label="β=$β")
end
axislegend(ax1; position=:lt)
axislegend(ax2; position=:lt)
fig
```

## Hot Ion Dispersion (DKNoPol)

### Ion susceptibility tensor

The hot ion susceptibility sums over cyclotron harmonics $n$ (KineticDR's `GordeyevSeries`, adaptive truncation):

$$b = k_\perp^2\rho_i^2, \qquad \Gamma_n(b) = e^{-b}I_{|n|}(b), \qquad \Gamma'_n(b) = e^{-b}\!\left[\tfrac{1}{2}(I_{|n|-1}+I_{|n|+1})-I_{|n|}\right],$$
$$\zeta_n = \frac{\omega - n\Omega_i}{\sqrt{2}\,k_\parallel v_{ti}}, \qquad \zeta_0 = \frac{\omega}{\sqrt{2}\,k_\parallel v_{ti}}.$$

$$\begin{aligned}
(\chi_i)_{xx} &= \frac{1}{\omega^2}\sum_n \frac{n^2}{b}\,\Gamma_n\,\zeta_0 Z(\zeta_n) \\
(\chi_i)_{xy} &= -(\chi_i)_{yx} = \frac{1}{\omega^2}\sum_n in\,\Gamma'_n\,\zeta_0 Z(\zeta_n) \\
(\chi_i)_{xz} &= (\chi_i)_{zx} = -\frac{1}{\omega^2}\sum_n \frac{n}{\sqrt{2b}}\,\Gamma_n\,\zeta_0 Z'(\zeta_n) \\
(\chi_i)_{yy} &= \frac{1}{\omega^2}\sum_n \!\left[\frac{n^2}{b}\Gamma_n - 2b\Gamma'_n\right]\zeta_0 Z(\zeta_n) \\
(\chi_i)_{yz} &= -(\chi_i)_{zy} = \frac{1}{\omega^2}\sum_n i\sqrt{\tfrac{b}{2}}\,\Gamma'_n\,\zeta_0 Z'(\zeta_n) \\
(\chi_i)_{zz} &= -\frac{1}{\omega^2}\sum_n \Gamma_n\,\zeta_0\zeta_n Z'(\zeta_n)
\end{aligned}$$

with $Z$ the plasma dispersion function. For $k_\parallel=0$, $\zeta_0 Z(\zeta_n)\to -\omega/(\omega-n)$ and the $xz,\,yz$ terms vanish. For $k_\perp \to 0$ only $n = 0, \pm 1$ survive, the latter through $n^2\Gamma_n/b \to \tfrac{1}{2}$.

### Full dispersion matrix

$$\mathcal{D}_\perp(\omega,\mathbf{k}) = \chi_{i\perp} + \begin{pmatrix} 0 & -i\chi_H \\ i\chi_H & 0 \end{pmatrix} - \frac{2}{\beta_i}\frac{k^2}{\omega^2}\mathbf{P}_{T\perp}, \qquad \det\left(\omega^2\mathcal{D}_\perp\right) = 0.$$

For **parallel propagation** ($k_\perp = 0$) the system splits into the two circular polarizations, $\chi_i^\pm = (\chi_i)_{xx} \pm i(\chi_i)_{xy}$:

$$\chi_i^\pm \pm \chi_H - \frac{2}{\beta_i}\frac{k_\parallel^2}{\omega^2} = 0.$$

For **perpendicular propagation** ($k_\parallel = 0$) the $2\times2$ block contains the electrostatic ion Bernstein modes and the compressional (extraordinary) branch.

```julia; echo=false, label="fig-hot-parallel", fig_cap="Parallel propagation hot dispersion (β=0.5). Cold reference: black. Hot roots colored by Re(ω)<1 (orange) / Re(ω)>1 (blue); roots with |Im ω| > 0.5 are not shown."

βi_h = 0.5
kz_vals = range(0.02, 3.0, length=50)
par_spectrum = spectrum(darwin_model(βi_h, μ_ref, KDR.GordeyevSeries()), kz_vals, :par; im_seeds=(-0.01, -0.1))
kpar_k = first.(par_spectrum); ωre = real.(last.(par_spectrum)); ωim = imag.(last.(par_spectrum))

fig = Figure(size=(800, 620))
ax1 = Axis(fig[1,1], xlabel="k∥ ρᵢ", ylabel="Re(ω)/Ωᵢ", limits=(nothing,(0,8)))
ax2 = Axis(fig[2,1], xlabel="k∥ ρᵢ", ylabel="Im(ω)/Ωᵢ")
overlay!(ax1, darwin_model(βi_h, μ_ref, KDR.Cold()), kz_vals, :par; color=:black, label="cold")
for (sel, c, l) in ((ωre .< 1.0, WONG[2], "Re(ω)<1"), (ωre .> 1.0, WONG[6], "Re(ω)>1"))
    scatter!(ax1, kpar_k[sel], ωre[sel]; color=c, label=l)
    scatter!(ax2, kpar_k[sel], ωim[sel]; color=c)
end
axislegend(ax1; position=:lt)
hlines!(ax2, [0.0]; color=:gray, linestyle=:dash)
linkxaxes!(ax1, ax2)
fig
```

```julia; echo=false, label="fig-hot-perp", fig_cap="Perpendicular propagation hot dispersion (β=0.5). Cold reference: black. Hot roots including ion Bernstein branches."

kx_vals = range(0.05, 4.0, length=75)
fig = Figure(size=(850, 480))
ax = Axis(fig[1,1], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", limits=(nothing,(0,8)))
overlay!(ax, darwin_model(βi_h, μ_ref, KDR.Cold()), kx_vals, :perp; color=:black, label="cold")
overlay!(ax, darwin_model(βi_h, μ_ref, KDR.GordeyevSeries()), kx_vals, :perp; color=WONG[3], label="hot")
axislegend(ax; position=:lt)
fig
```

## Cold Plasma Simulation

The linearized cold-ion fluid (`ColdIonFluid`) is used to validate the EM field closure. It integrates the cold-limit equations $\partial_t\delta\mathbf{u}_i = \mathbf{E} + \Omega_i(\delta\mathbf{u}_i\times\hat{b})$, $\partial_t\delta n = -\nabla\cdot\delta\mathbf{u}_i$ with constant background density $n_0=1$ fed to the field solver. No velocity-space grid is required, so the field can also point along $x_1$ (parallel propagation). A broadband seed in $\mathbf{B}$ excites all linear eigenmodes; the spectrum $\log|A(k,\omega)|$ is extracted via windowed FFT.

```julia; echo=false, results="hidden", label="sim-cold"
β_cold = 0.05; μ_cold = 0.1
Nx_cold = 64
Lz_cold = 100π; Lx_cold = 20π
dt_cold = 0.002; Tmax_cold = 500.0

grid_par_cold = bslLD.Grid(
    [0.0, -1.0, -1.0], [Lz_cold, 1.0, 1.0],
    [Nx_cold, 1, 1], 1, 1.0, 1)

grid_perp_cold = bslLD.Grid(
    [0.0, -1.0, -1.0], [Lx_cold, 1.0, 1.0],
    [Nx_cold, 1, 1], 1, 1.0, 3)

diag_par_cold  = run_sim(β_cold, μ_cold, dt_cold, Tmax_cold, grid_par_cold;  stepper=bslLD.step_cold!, ε=1e-7);
diag_perp_cold = run_sim(β_cold, μ_cold, dt_cold, Tmax_cold, grid_perp_cold; stepper=bslLD.step_cold!, ε=1e-7);
```

```julia; echo=false, label="fig-cold-sim", fig_cap="Cold plasma simulation (β=0.05). Spectra of Bz with cold analytic branches (white)."

m_cold = darwin_model(β_cold, μ_cold, KDR.Cold())
fig = Figure(size=(1000, 420))
for (ci, (dir, diag, grid, ks, lims)) in enumerate((
        (:par,  diag_par_cold,  grid_par_cold,  range(0.02, 0.6, length=40), ((0,0.6),(0,6))),
        (:perp, diag_perp_cold, grid_perp_cold, range(0.05, 3.0, length=50), ((0,3.0),(0,8)))))
    ax = Axis(fig[1,ci], xlabel=(dir == :par ? "k∥ ρᵢ" : "k⊥ ρᵢ"), ylabel="ω/Ωᵢ",
              title="$(dir == :par ? "Parallel" : "Perpendicular") (β=$β_cold)", limits=lims)
    plot_spectrum!(ax, diag, dt_cold, grid)
    overlay!(ax, m_cold, ks, dir; color=:white, label="cold analytic")
    axislegend(ax; position=:lt)
end
fig
```

## Implementation

### Discretization

Phase space is discretized on a uniform Cartesian grid $N_x \times N_v \times N_v$ with periodic $x$ and bounded $v \in [-v_\mathrm{max}, v_\mathrm{max}]$. The BSL (backward semi-Lagrangian) scheme traces each grid characteristic backward by $\Delta t$ and reconstructs the distribution via **spectral (Fourier) interpolation** (`advectorCart.jl`). Spatial field operators (curl, divergence) are computed pseudospectrally via FFTW.

### Operator notation

| Symbol | Meaning |
|---|---|
| $V_\tau[\mathbf{E},\mathbf{B}]$ | Velocity-space Lorentz advection over time $\tau$ |
| $X_\tau$ | Spatial advection over time $\tau$ |
| $\mathcal{M}[f]$ | Moment evaluation: $(n_i,\mathbf{J}_{i\perp})$ |
| $\mathcal{F}_{\Delta t}$ | **1st-order field solve**: semi-implicit with $\alpha=2\Delta t/\beta_i$ (backward-Euler coupling); **Faraday applied inside** the linear system |
| $\mathcal{F}^m_{\Delta t}$ | **2nd-order field solve**: midpoint with $\alpha=\Delta t/\beta_i$; **Faraday suppressed** inside — applied separately after with full $\Delta t$ |

Phase values $\tfrac{1}{4},\tfrac{1}{2},\tfrac{3}{4}$ refer to accumulated gyro-phase $\phi = \Omega_i t$ at each substep; the rotating-frame advection routines require this to be updated consistently.

### Field solve: the 3×3 linear system

The electromagnetic field equations in Fourier space reduce to a single $3\times3$ system for $\hat{\mathbf{E}}$. For a given current $\mathbf{J}_{i\perp}^m$ and background field $\mathbf{B}^n$, define the source

$$\hat{\mathbf{w}} = \frac{2}{\beta_i}\,i\mathbf{k}\times\hat{\mathbf{B}}^n - \hat{\mathbf{J}}_{i\perp}^m.$$

The system $A(\mathbf{k})\hat{\mathbf{E}} = \mathbf{r}$ is solved mode by mode via Cramer's rule:

$$A=\begin{pmatrix}1+\alpha k_2^2-\alpha k_1 k_2&\alpha(k_1^2+k_z^2)&-\alpha k_2 k_z\\-\alpha(k_2^2+k_z^2)&1+\alpha k_1 k_2&\alpha k_1 k_z\\k_z k_1&k_z k_2&-k_\perp^2-\lambda\end{pmatrix}, \qquad \mathbf{r}=\begin{pmatrix}\hat{w}_2\\-\hat{w}_1\\\tfrac{\beta_i}{2}\widehat{\nabla\cdot\boldsymbol\Pi_\mathrm{diff}}\end{pmatrix},$$

where $k_\perp^2 = k_1^2+k_2^2$ and $\lambda = \tfrac{\beta_i}{2}(1+1/\mu)$. The coupling parameter $\alpha$ depends on the integrator:

$$\alpha = \begin{cases} 2\Delta t/\beta_i & \text{1st-order scheme (`step!`): Faraday folded inside the solve} \\ \Delta t/\beta_i & \text{2nd-order midpoint (`stepMidpoint!`): Faraday applied after} \\ 2\theta\Delta t/\beta_i & \text{damped midpoint with } \theta = \tfrac{1}{2}+\kappa\Delta t \end{cases}$$

In the 1st-order case Faraday's law $\hat{\mathbf{B}}^{n+1} = \hat{\mathbf{B}}^n - \Delta t\,i\mathbf{k}\times\hat{\mathbf{E}}^{n+1}$ is substituted into $\mathbf{E}_\perp$ before building $A$, so $\mathbf{E}^{n+1}$ and $\mathbf{B}^{n+1}$ emerge jointly. In the 2nd-order case the solve targets only $\mathbf{E}^m$; $\mathbf{B}^{n+1}$ is updated explicitly after convergence via

$$\hat{\mathbf{B}}^{n+1} = \hat{\mathbf{B}}^n - \Delta t\,i\mathbf{k}\times\hat{\mathbf{E}}^m.$$

All three variants call the same kernel; only $\alpha$ and whether `dt_faraday` is nonzero differ.

### V–X–C–X–V splitting (`step!`)

The first-order integrator uses a Strang-symmetric kinetic split with the field solve at the centre:

$$\begin{aligned}
f^{(1)} &= V_{\Delta t/2}[\mathbf{E}^n]\,f^n, \\
f^{(2)} &= X_{\Delta t/2}\,f^{(1)}, \\
\bigl(n^m,\mathbf{J}^m\bigr) &= \mathcal{M}[f^{(2)}], \\
\bigl(\mathbf{E}^{n+1},\mathbf{B}^{n+1}\bigr) &= \mathcal{F}_{\Delta t}(\mathbf{B}^n,\mathbf{J}^m), \\
f^{(3)} &= X_{\Delta t/2}\,f^{(2)}, \\
f^{n+1} &= V_{\Delta t/2}[\mathbf{E}^{n+1}]\,f^{(3)}.
\end{aligned}$$

The field solve $\mathcal{F}_{\Delta t}$ uses $\alpha = 2\Delta t/\beta_i$ (backward-Euler): Faraday's law is substituted into $\mathbf{E}_\perp$ before assembling $A$, so $\mathbf{E}^{n+1}$ and $\mathbf{B}^{n+1}$ are determined simultaneously. Although the kinetic split is Strang-symmetric, the electromagnetic part is first-order accurate because the backward-Euler coupling is $O(\Delta t)$.

**Cost:** 2 kinetic pushes $V_{\Delta t/2}$, 1 moment reduction, 1 field solve. **Order:** $O(\Delta t)$.

### X–C–X midpoint splitting (`stepMidpoint!`)

The second-order integrator advances spatial characteristics across the full step and finds a midpoint field $\mathbf{E}^m$ via a predictor–corrector:

$$f^a = X_{\Delta t/2}\,f^n, \qquad [\text{C substep: find } \mathbf{E}^m], \qquad f^{n+1} = X_{\Delta t/2}\,f^b.$$

The C substep uses the midpoint field solve $\mathcal{F}^m_{\Delta t}$ with $\alpha = \Delta t/\beta_i$. Faraday is not folded into the linear system; it is applied explicitly after convergence:

$$\mathbf{B}^{n+1} = \mathbf{B}^n - \Delta t\,\nabla\times\mathbf{E}^m.$$

This is the implicit midpoint rule for Faraday: eliminating $\mathbf{B}^m = \mathbf{B}^n - \tfrac{\Delta t}{2}\nabla\times\mathbf{E}^m$ from $\mathbf{E}_\perp^m$ gives exactly the $3\times3$ system with $\alpha = \Delta t/\beta_i$. The particle push in the C substep then uses the converged midpoint field: $f^b = V_{\Delta t}[\mathbf{E}^m]f^a$. The splitting error is $O(\Delta t^3)$ per step (Strang) and the field solve is $O(\Delta t^2)$ (midpoint rule), giving global $O(\Delta t^2)$.

The `coupling` keyword sets how $\mathbf{E}^m$ is found.

**Mode A** (`:predictor_only`) — frozen-phase current predictor:

$$\begin{aligned}
1.\quad & f^a = X_{\Delta t/2}\,f^n. \\
2.\quad & n^a = \mathcal{M}_n[f^a], \qquad \mathbf{J}^a = \mathcal{M}_J[f^a]. \\
3.\quad & \mathbf{J}^m_\mathrm{pred} = \mathbf{J}^a + q_i n^a \frac{\Delta t}{2}\mathbf{E}^n. \\
4.\quad & \mathbf{E}^m = \mathcal{F}^m_{\Delta t}(\mathbf{B}^n,\mathbf{J}^m_\mathrm{pred}). \\
5.\quad & f^b = V_{\Delta t}[\mathbf{E}^m]\,f^a. \\
6.\quad & \mathbf{B}^{n+1} = \mathbf{B}^n - \Delta t\,\nabla\times\mathbf{E}^m. \\
7.\quad & f^{n+1} = X_{\Delta t/2}\,f^b, \qquad \mathbf{E}^{n+1} = \mathbf{E}^m.
\end{aligned}$$

Step 3 is a first-order frozen-phase predictor: during the C substep there is no spatial transport and the gyro-phase is fixed, so the push is a uniform velocity kick and the current evolves as $\mathbf{J}^a + q_i n^a\tau\mathbf{E}$. Using $\mathbf{E}^n$ instead of $\mathbf{E}^m$ makes the error in $\mathbf{J}^m$ $O(\Delta t^2)$, enough for global second order.

**Mode C** (`:moment_kinetic_corrector`) — one kinetic correction after Mode A step 4. Starting from $\mathbf{E}^m_\mathrm{pred}$ obtained at step 4:

$$\begin{aligned}
5\mathrm{a}.\quad & f^{m,p} = V_{\Delta t/2}[\mathbf{E}^m_\mathrm{pred}]\,f^a, \qquad \mathbf{J}^m_\mathrm{kin} = \mathcal{M}_J[f^{m,p}]. \\
5\mathrm{b}.\quad & \mathbf{E}^m = \mathcal{F}^m_{\Delta t}(\mathbf{B}^n,\mathbf{J}^m_\mathrm{kin}).
\end{aligned}$$

Then continue with steps 5–7 of Mode A using the corrected $\mathbf{E}^m$. Mode C adds one kinetic push and one field solve over Mode A but produces a kinetically consistent midpoint current.

**Picard** (`:kinetic_picard`) repeats 5a–5b until $\max|\Delta E_y| <$ `picard_tol` (at most `picard_maxiter` times).

### θ-method (damped midpoint, `damping_rate`)

Setting `damping_rate` $=\kappa > 0$ gives $\theta = \tfrac{1}{2} + \kappa\Delta t$ (with $\theta \leq 1$) and shifts the field-solve stage off-centre. Because $\theta - \tfrac{1}{2} = O(\Delta t)$, the modification to $\alpha = 2\theta\Delta t/\beta_i$ enters the local truncation error at $O(\Delta t^3)$, so global order remains $O(\Delta t^2)$. The stage current predictor and kinetic corrector push both use $\tau = \theta\Delta t$:

$$\mathbf{J}^\theta_\mathrm{pred} = \mathbf{J}^a + q_i n^a \theta\Delta t\,\mathbf{E}^n, \qquad \mathbf{J}^\theta_\mathrm{kin} = \mathcal{M}_J\!\left[V_{\theta\Delta t}[\mathbf{E}^\theta]\,f^a\right].$$

The full Faraday update after convergence uses the complete $\Delta t$:

$$\mathbf{B}^{n+1} = \mathbf{B}^n - \Delta t\,\nabla\times\mathbf{E}^\theta.$$

This is orthogonal to the `coupling` parameter. At `damping_rate=0` (the default), $\theta=\tfrac{1}{2}$ and behaviour is identical to the unmodified scheme. A sensible starting point is $\kappa \ll \Omega_i$ so that $\kappa\Delta t \ll 1$.

### Cost and accuracy summary

| Mode | Kinetic pushes | Moment reductions | Field solves | Order |
|---|---|---|---|---|
| `step!` (V-X-C-X-V) | 2 ($V_{\Delta t/2}$) | 1$n$+1$J$ | 1 ($\alpha=2\Delta t/\beta_i$) | $O(\Delta t)$ |
| Mode A (`:predictor_only`) | 1 ($V_{\Delta t}$) | 1$n$+1$J$ | 1 ($\alpha=\Delta t/\beta_i$) | $O(\Delta t^2)$ |
| Mode C (`:moment_kinetic_corrector`) | 2 ($V_{\theta\Delta t}$, $V_{\Delta t}$) | 1$n$+2$J$ | 2 | $O(\Delta t^2)$ |
| Picard (`:kinetic_picard`) | $1 + p$ | 1$n$+$(1+p)J$ | $1+p$ | $O(\Delta t^2)$ |

($p$ = number of Picard iterations.)

### Convergence test

```julia; echo=false, results="hidden", label="sim-conv"
T_cv = 1.0; vmax_cv = 6.0*sqrt(T_cv)
grid_cv = bslLD.Grid(
    [0.0, -vmax_cv, -vmax_cv], [25π, vmax_cv, vmax_cv],
    [32, 32, 32], 1, 1.0, 3)

β_cv = 0.1; μ_cv = 0.01; Tmax_cv = 10.0
dts  = [0.0025, 0.01, 0.025, 0.05]

midpoint(; kw...) = (f,s,g,t,v) -> stepMidpoint!(f,s,g,t,v; kw...)
steppers_cv = [("step! (V-X-C-X-V)", step!),
               ("Mode A",            midpoint(coupling=:predictor_only)),
               ("Mode C",            midpoint(coupling=:moment_kinetic_corrector)),
               ("Mode C, κ=0.1",     midpoint(coupling=:moment_kinetic_corrector, damping_rate=0.1)),
               ("Picard",            midpoint(coupling=:kinetic_picard))]
colors_cv  = [WONG[6], WONG[4], WONG[7], WONG[2], WONG[8]]
markers_cv = [:circle, :utriangle, :diamond, :hexagon, :star5]

diags_cv = Dict(label => [(dt, run_sim(β_cv, μ_cv, dt, Tmax_cv, grid_cv; stepper, ε=1e-6, T=T_cv,
                                       seed_field=:Ey, vnoise=1e-6)) for dt in dts]
                for (label, stepper) in steppers_cv)

function plot_history_grid(field)
    fig = Figure(size=(1000, 620))
    for (ci, (label, _)) in enumerate(steppers_cv)
        row, col = divrem(ci-1, 2)
        ax = Axis(fig[row+1, col+1], xlabel="t", ylabel="⟨$(field)²⟩", title=label, yscale=log10)
        for (dti, (dt, d)) in enumerate(diags_cv[label])
            lines!(ax, d.t, mean_sq(d, field); color=(colors_cv[ci], 0.5 + 0.5*dti/length(dts)), label="dt=$dt")
        end
        axislegend(ax; position=:lt)
    end
    fig
end
```

```julia; echo=false, label="fig-energy-cv", fig_cap="⟨Ey²⟩(t) for all steppers at all tested dt values."
plot_history_grid(:Ey)
```

```julia; echo=false, label="fig-Bfield-cv", fig_cap="⟨Bz²⟩(t) for all steppers at all tested dt values. Compare with fig-energy-cv for the electric-field counterpart."
plot_history_grid(:Bz)
```

```julia; echo=false, label="fig-conv", fig_cap="L1 error in Ey at final time vs dt. Reference: finest dt within each stepper."

fig = Figure(size=(700, 480))
ax = Axis(fig[1,1], xlabel="Δt", ylabel="L₁ error in Eᵧ", xscale=log10, yscale=log10,
          title="Convergence: step! vs stepMidpoint!")

l1_err(label, i) = mean(abs.(diags_cv[label][i][2].Ey[end] .- diags_cv[label][1][2].Ey[end]))
for (ci, (label, _)) in enumerate(steppers_cv)
    scatterlines!(ax, dts, [l1_err(label, i) for i in eachindex(dts)];
                  color=colors_cv[ci], marker=markers_cv[ci], label=label)
end

# Reference lines anchored at dts[2]
lines!(ax, dts[2:end], (dts[2:end]./dts[2]) .* l1_err("step! (V-X-C-X-V)", 2);
       color=:gray, linestyle=:dash, label="O(Δt)")
lines!(ax, dts[2:end], (dts[2:end]./dts[2]).^2 .* l1_err("Mode C", 2);
       color=:gray, linestyle=:dashdot, label="O(Δt²)")

Legend(fig[1,2], ax)
fig
```

```julia; echo=false, results="hidden", label="sim-damping-growth"

function fit_growth_rate(t_vec, E2_vec)
    t_half = t_vec[end] / 2
    idx = findall(t -> t >= t_half, t_vec)
    log_E2 = log.(max.(E2_vec[idx], 1e-60))
    t_fit = t_vec[idx] .- t_vec[idx[1]]
    slope = (length(t_fit) * dot(t_fit, log_E2) - sum(t_fit)*sum(log_E2)) /
            (length(t_fit) * dot(t_fit, t_fit) - sum(t_fit)^2)
    return slope / 2   # γ = slope/2 since ⟨E²⟩ ~ e^{2γt}
end

κ_vals_gr = [0.0, 0.05, 0.1, 0.5]
Tmax_gr   = 80.0; dt_gr = 0.025

diags_growth = [run_sim(β_cv, μ_cv, dt_gr, Tmax_gr, grid_cv; stepper=midpoint(damping_rate=κ),
                        ε=1e-6, T=T_cv, seed_field=:Ey, vnoise=1e-6) for κ in κ_vals_gr]

γ_vals = Dict(field => [fit_growth_rate(d.t, mean_sq(d, field)) for d in diags_growth] for field in (:Ey, :Bz))

function plot_damping(field)
    fig = Figure(size=(800, 400))
    ax = Axis(fig[1,1], xlabel="t", ylabel="⟨$(field)²⟩", yscale=log10,
              title="Damping sweep β=$β_cv, κ ∈ $κ_vals_gr")
    for (i, (κ, d)) in enumerate(zip(κ_vals_gr, diags_growth))
        X2 = mean_sq(d, field)
        lines!(ax, d.t, X2; color=WONG[i+1], label="κ=$κ")
        idx_h = findfirst(t -> t >= d.t[end] / 2, d.t)
        t_fit = d.t[idx_h:end]
        lines!(ax, t_fit, X2[idx_h] .* exp.(2γ_vals[field][i] .* (t_fit .- t_fit[1]));
               color=WONG[i+1], linestyle=:dash, linewidth=1)
    end
    axislegend(ax; position=:lt)
    fig
end
```

```julia; echo=false, label="fig-damping-Ey", fig_cap="⟨Ey²⟩(t) with and without numerical damping (Mode C, β=0.1, μ=0.01, dt=0.025). Dashed lines show the fitted growth rate 2γ extracted from the second half of each run."
plot_damping(:Ey)
```

```julia; echo=false, label="fig-damping-Bz", fig_cap="⟨Bz²⟩(t) with and without numerical damping. Dashed lines show the fitted growth rate 2γ."
plot_damping(:Bz)
```

```julia; echo=false, label="fig-kappa-sweep", fig_cap="Effective growth rate γ vs κ extracted from the last half of each time series via linear regression on log⟨E²⟩ (circles: Ey, squares: Bz)."

fig = Figure(size=(600, 380))
ax = Axis(fig[1,1], xlabel="κ", ylabel="γ (growth rate)", title="Growth rate vs damping κ")
scatterlines!(ax, κ_vals_gr, γ_vals[:Ey]; color=WONG[6], marker=:circle, label="Ey")
scatterlines!(ax, κ_vals_gr, γ_vals[:Bz]; color=WONG[4], marker=:rect, label="Bz")
hlines!(ax, [0.0]; color=:gray, linestyle=:dash)
axislegend(ax; position=:rt)
fig
```

## Kinetic Simulations

All kinetic simulations use Mode C (`stepMidpoint!` with `:moment_kinetic_corrector`). Parameters: $\mu=0.1$, $T_i=1$, $N_x=64$, $N_v=32$, $v_\mathrm{max}=6\,v_\mathrm{th}$, $\Delta t = 0.01$, $t_\mathrm{max} = 200$, perpendicular propagation ($\hat{b} = \hat{z}$, $L_x = 20\pi$). Parallel propagation is tested with the cold fluid only: the 1D2v grid has velocities $(v_1, v_2)$, while gyration about a field along $x_1$ needs $(v_2, v_3)$.

```julia; echo=false, results="hidden", label="sim-kinetic"
μ_kin = 0.1; T_kin = 1.0; Nx_kin = 64; Nv_kin = 32
vmax_kin = 6.0*sqrt(T_kin)
Lx_kin = 20π
dt_kin = 0.01; Tmax_kin = 200.0

βi_lo = 0.05; βi_hi = 0.5

grid_perp_kin = bslLD.Grid(
    [0.0, -vmax_kin, -vmax_kin], [Lx_kin, vmax_kin, vmax_kin],
    [Nx_kin, Nv_kin, Nv_kin], 1, 1.0, 3)

diag_perp_lo = run_sim(βi_lo, μ_kin, dt_kin, Tmax_kin, grid_perp_kin; T=T_kin);
diag_perp_hi = run_sim(βi_hi, μ_kin, dt_kin, Tmax_kin, grid_perp_kin; T=T_kin);
runs_kin = [(βi_lo, diag_perp_lo), (βi_hi, diag_perp_hi)]
```

```julia; echo=false, label="fig-kin-perp", fig_cap="Perpendicular propagation kinetic spectra (density). White: cold analytic. Colored: hot analytic roots."

kx_kin = range(0.05, 4.0, length=50)
fig = Figure(size=(1000, 430))
for (ci, (β, diag)) in enumerate(runs_kin)
    ax = Axis(fig[1,ci], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ",
              title="Perpendicular β=$β", limits=((0,4),(0,8)))
    plot_spectrum!(ax, diag, dt_kin, grid_perp_kin; field=:ni)
    overlay!(ax, darwin_model(β, μ_kin, KDR.Cold()),           kx_kin, :perp; color=:white,  label="cold analytic")
    overlay!(ax, darwin_model(β, μ_kin, KDR.GordeyevSeries()), kx_kin, :perp; color=WONG[3], label="hot analytic")
    axislegend(ax; position=:lt)
end
fig
```

## Conservation Diagnostics

The two discrete conservation laws of interest are **Faraday's law**

$$\frac{\mathbf{B}^{n+1} - \mathbf{B}^n}{\Delta t} + \nabla\times\mathbf{E}^m = 0$$

and the **quasineutrality constraint** $\delta n_i \ll n_0$. The first is enforced by construction of `apply_faraday!`; the residual below only checks that it matches an independent spectral curl. The second is monitored via $\max_x|n_i(x,t) - 1|$, which should remain small in the linear regime and grow at most algebraically as nonlinear effects develop.

```julia; echo=false, label="fig-faraday-kin", fig_cap="Faraday residual ‖Bz^{n+1}−Bz^n+dt·∂_{x1}Ey^m‖∞ over time for both kinetic simulations. Dashed line: machine ε."

fig = Figure(size=(1000, 420))
ax = Axis(fig[1,1], xlabel="t / Ωᵢ⁻¹", ylabel="‖Faraday residual‖∞", yscale=log10,
          title="Faraday conservation")
for (ci, (β, diag)) in enumerate(runs_kin)
    lines!(ax, diag.t[2:end], faraday_residuals(diag, dt_kin, grid_perp_kin); color=WONG[ci+1], label="β=$β")
end
hlines!(ax, [eps(Float64)]; color=:gray, linestyle=:dash, label="machine ε")
axislegend(ax; position=:rt)
fig
```

```julia; echo=false, label="fig-qn-kin", fig_cap="Quasineutrality indicator max|nᵢ−1| over time for both kinetic simulations. Small values confirm the linear regime; saturation marks nonlinear onset."

fig = Figure(size=(1000, 420))
ax = Axis(fig[1,1], xlabel="t / Ωᵢ⁻¹", ylabel="max|nᵢ − 1|", yscale=log10,
          title="Quasineutrality indicator")
for (ci, (β, diag)) in enumerate(runs_kin)
    lines!(ax, diag.t, [maximum(abs.(ni .- 1.0)) for ni in diag.ni]; color=WONG[ci+1], label="β=$β")
end
axislegend(ax; position=:lt)
fig
```

## Drift-kinetic electrons with polarisation density (`EMSolverDKPolDensity`)

### Model

This is the "DK + polarisation density" electron model of the hybrid-model study (`projects/hybrid_model_map`, final model; note *hybrid-electron-reductions-polarisation-and-mode-exclusion*, model E4). The electrons are drift-kinetic and massless across the field, except for the polarisation **charge** $w\mu\nabla_\perp^2\phi$ (weight $w$, physical $w=1$). The transverse polarisation current is dropped. In KineticDR units the electron susceptibility is

$$\chi_e = \chi_e^{\rm DK} + w\mu\,\frac{k_\perp^2}{k^2}\,\hat{k}\hat{k}^{\mathsf T}.$$

DKPol keeps the full polarisation current, $\chi_e^{\rm DK} + \mu\,\mathbf{I}_\perp$ (KineticDR `DriftKinetic(polarization = true)`, model E2). Its transverse part adds a spurious cut-off at $|\omega| = \Omega_e/w + \Omega_i$. The density-only model has no root above $\Omega_e$ and caps the compressional branch at the lower-hybrid frequency $\omega_{LH}/\sqrt{w} = (w\mu)^{-1/2}\,\Omega_i$.

### Charge form

The solver imposes quasineutrality itself rather than its time derivative $\nabla\cdot\mathbf{J}=0$. In 1D with $\mathbf{k}\perp\hat{b}$, the only geometry where kinetic ions can test the term here, the electron guiding-centre density is frozen in, $\delta n_e = \delta B_z$. Per Fourier mode, with $c = 2/\beta_i$ and $d_e^2 = c\mu$:

$$\left(1 + w d_e^2 k^2\right)\hat{B}_z = \hat{n}_i + ikw\mu\,\hat{J}_{iy}, \qquad \hat{E}_x = -c\,ik\hat{B}_z - \hat{J}_{iy}, \qquad \hat{E}_y = -\partial_t\hat{A}_y,\ \ \hat{B}_z = ik\hat{A}_y .$$

Quasineutrality and the transverse Ampère law hold at every time level. The inductive field needs $B_z^{n+1}$, i.e. the ion density at the end of the step, which depends on the stage field through the C kick. `solve_fields_moment_implicit!` linearises that response around the background density ($\mathbf{J}^m = \mathbf{J}^a + n_0\tfrac{\Delta t}{2}\mathbf{E}^m$, $n^{n+1} = n^a - \tfrac{\Delta t}{2}\partial_x(J_x^a + n_0\Delta t E_x^m)$) and solves for $\mathbf{E}^m$ and $B_z^{n+1}$ per mode. A kinetic corrector then replaces the linear model by the moments of a trial push, keeping the difference as a fixed defect (`stepMidpointQN!`, and `step_cold!` for the cold fluid). $B_z^{n+1}$ is finally reset from quasineutrality with the actual moments.

So quasineutrality holds exactly, while Faraday's law holds only up to the predictor–corrector error. This is the opposite of the rate-form solvers. For cold ions the scheme reproduces

$$\omega^2 = \frac{c k^2 (1 + w\mu)}{1 + w\mu + w\mu c k^2},$$

which is a root of the KineticDR matrix above to $\sigma_{\min}/\sigma_{\max} < 2\times10^{-11}$ (24 cases, β ∈ {0.05, 0.5}, μ ∈ {0.01, 1/1836}, w ∈ {1, 0.5}). It converges at second order (unit tests).

All runs below use $\mu = 0.01$ ($\omega_{LH} = 10\,\Omega_i$, $\Omega_e = 100\,\Omega_i$) and seed the ion density, starting from a quasineutral $B_z$.

```julia; echo=false, results="hidden", label="sim-pol-cold"
β_pc = 0.05; μ_pc = 0.01; dt_pc = 0.002; Tmax_pc = 200.0
grid_pc = bslLD.Grid([0.0, -1.0, -1.0], [20π, 1.0, 1.0], [64, 1, 1], 1, 1.0, 3)
pol_cold = [
    ("DKNoPol",      bslLD.EMSolverDKNoPol(β_pc, μ_pc),      dperp(darwin_model(β_pc, μ_pc, KDR.Cold()), :perp)),
    ("DKPol (E2)",   bslLD.EMSolverDKPol(β_pc, μ_pc),        dperp(darwin_model(β_pc, μ_pc, KDR.Cold(); pol=true), :perp)),
    ("DKPolDensity", bslLD.EMSolverDKPolDensity(β_pc, μ_pc), dperp_poldensity(β_pc, μ_pc, KDR.Cold())),
]
diags_pc = [run_sim(β_pc, μ_pc, dt_pc, Tmax_pc, grid_pc; stepper=bslLD.step_cold!, solver, ε=1e-7, seed_field=:n)
            for (_, solver, _) in pol_cold]

# Relative error of the simulated spectral peak next to each analytic root (parabolic peak refinement).
function peak_errors(diag, dt, grid, D; field=:Bz, ωmax=8.0, re=HARMONIC_SEEDS)
    k, ω, spec = make_spec(diag, dt, grid; field)
    errs = Float64[]
    for (j, kj) in enumerate(k), (_, r) in spectrum(D, [kj]; re, ωmax)
        i = argmin(abs.(ω .- real(r)))
        lo = max(i - 3, 1)
        ip = clamp(lo - 1 + argmax(spec[lo:min(i+3, end), j]), 2, length(ω) - 1)
        y0, y1, y2 = spec[ip-1, j], spec[ip, j], spec[ip+1, j]
        push!(errs, abs((ω[ip] + (y0 - y2) / (2(y0 - 2y1 + y2)) * (ω[2] - ω[1])) / real(r) - 1))
    end
    return errs
end
re_pc = range(0.1, 120.0, length=600)
errs_pc = [peak_errors(d, dt_pc, grid_pc, D; ωmax=120.0, re=re_pc) for (d, (_, _, D)) in zip(diags_pc, pol_cold)]
```

```julia; echo=false, label="fig-pol-cold", fig_cap="Cold ions, k ⊥ b̂, β=0.05, μ=0.01: spectra of Bz for the three electron closures, each with its own KineticDR branches (white). Dashed: ω_LH = 10 Ωᵢ and Ω_e + Ω_i = 101 Ωᵢ."

fig = Figure(size=(1200, 430))
for (ci, ((label, _, D), diag)) in enumerate(zip(pol_cold, diags_pc))
    ymax = label == "DKPol (E2)" ? 120 : 25
    ax = Axis(fig[1,ci], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", title=label, limits=((0, 3.2), (0, ymax)))
    plot_spectrum!(ax, diag, dt_pc, grid_pc)
    overlay!(ax, D, range(0.05, 3.2, length=50); color=:white, label="KineticDR", ωmax=ymax, re=re_pc)
    hlines!(ax, [10.0, 101.0]; color=:gray, linestyle=:dash)
    axislegend(ax; position=:lt)
end
fig
```

```julia; echo=false, results="markup", label="tab-pol-cold"
for ((label, _, _), e) in zip(pol_cold, errs_pc)
    println(rpad(label, 14), "peaks: ", length(e), ",  median rel. error ", round(median(e), sigdigits=2),
            ",  90th percentile ", round(quantile(e, 0.9), sigdigits=2))
end
```

The table gives the relative frequency error of the simulated spectral peaks against the KineticDR roots of each model. The peak resolution is limited by the frequency bin, $2\pi/t_\mathrm{max} \approx 0.03\,\Omega_i$. The large DKPol 90th percentile comes from the E2 cut-off branch above $\Omega_e + \Omega_i$ ($k_\perp\rho_i \lesssim 1$). The density seed does not visibly excite it in $B_z$, so its "peaks" are noise. Whether DKPol supports that branch at all is not tested here (open).

```julia; echo=false, results="hidden", label="sim-pol-kin"
β_pk = [0.05, 0.5]; μ_pk = 0.01; dt_pk = 0.01; Tmax_pk = 100.0
diags_pk = [run_sim(β, μ_pk, dt_pk, Tmax_pk, grid_perp_kin; stepper=stepMidpointQN!,
                    solver=bslLD.EMSolverDKPolDensity(β, μ_pk), T=T_kin, seed_field=:n) for β in β_pk]
```

```julia; echo=false, label="fig-pol-kin", fig_cap="Kinetic ions with DKPolDensity electrons, k ⊥ b̂, μ=0.01: density spectra with the KineticDR branches of the same model (white: cold ions, colored: full-orbit ions). Dashed: ω_LH = 10 Ωᵢ."

fig = Figure(size=(1000, 430))
kx_pk = range(0.05, 3.1, length=50)
for (ci, (β, diag)) in enumerate(zip(β_pk, diags_pk))
    ax = Axis(fig[1,ci], xlabel="k⊥ ρᵢ", ylabel="ω/Ωᵢ", title="DKPolDensity, β=$β", limits=((0, 3.2), (0, 12)))
    plot_spectrum!(ax, diag, dt_pk, grid_perp_kin; field=:ni)
    overlay!(ax, dperp_poldensity(β, μ_pk, KDR.Cold()), kx_pk; color=:white, label="cold", ωmax=12.0)
    overlay!(ax, dperp_poldensity(β, μ_pk, KDR.GordeyevSeries()), kx_pk; color=WONG[3], label="hot", ωmax=12.0,
             re=sort(vcat(HARMONIC_SEEDS, 8.1:0.2:12.0, [n + s*d for n in 9:12 for s in (-1, 1) for d in (0.3, 0.1, 0.03, 0.01, 3e-3, 1e-3)])))
    hlines!(ax, [10.0]; color=:gray, linestyle=:dash)
    axislegend(ax; position=:lt)
end
fig
```

```julia; echo=false, label="fig-pol-diag", fig_cap="Constraint errors per step. Rate form (DKNoPol, cold): quasineutrality residual max|δBz − δn|. Charge form (DKPolDensity): Faraday residual ‖Bz^{n+1}−Bz^n+dt·∂ₓEy^m‖∞, i.e. the predictor–corrector error; quasineutrality holds to round-off."

fig = Figure(size=(1000, 400))
ax = Axis(fig[1,1], xlabel="t / Ωᵢ⁻¹", ylabel="residual / max|δn(0)|", yscale=log10, title="Constraint errors")
qn_res(d) = [maximum(abs.((B .- mean(B)) .- (n .- mean(n)))) for (B, n) in zip(d.Bz, d.ni)]
δn0(d) = maximum(abs.(d.ni[1] .- mean(d.ni[1])))
lines!(ax, diags_pc[1].t, qn_res(diags_pc[1]) ./ δn0(diags_pc[1]); color=WONG[2], label="DKNoPol cold: quasineutrality")
lines!(ax, diags_pc[3].t[2:end], faraday_residuals(diags_pc[3], dt_pc, grid_pc) ./ δn0(diags_pc[3]); color=WONG[6], label="DKPolDensity cold: Faraday")
for (ci, (β, d)) in enumerate(zip(β_pk, diags_pk))
    lines!(ax, d.t[2:end], faraday_residuals(d, dt_pk, grid_perp_kin) ./ δn0(d); color=WONG[6+ci], label="DKPolDensity kinetic β=$β: Faraday")
end
axislegend(ax; position=:rb)
fig
```

### Time-step limit

The term is stiff: the compressional branch reaches $\omega_{LH}$. The note (§8) estimates that a field solve which takes the ion density as given (lagged) is limited to $\Omega_i\Delta t \lesssim 1/\omega_{cap}$. `solve_fields!` for `EMSolverDKPolDensity` is that lagged form: $B_z^{n+1}$ from the current moments, $E_y$ from its difference to $B_z^n$, inside the first-order V–X–C–X–V cold step. The moment-implicit step treats the ion response to the stage field implicitly. Below, a single cold mode near the cap ($k\rho_i = 3$, $\beta = 0.05$, $\omega \approx 8.9\,\Omega_i$) is run for $t = 20$ with both forms.

```julia; echo=false, label="fig-pol-dt", fig_cap="Growth of a single cold mode over t = 20 vs Ωᵢ dt (k ρᵢ = 3, β = 0.05, μ = 0.01, ω ≈ 8.9 Ωᵢ): lagged charge-form solve vs the moment-implicit X–C–X step. Dashed: Ωᵢ dt = 1/ω_LH."

function cold_mode_growth(step, dt; k=3.0, β=0.05, μ=0.01, Tmax=20.0, Nx=32, m=4)
    grid = bslLD.Grid([0.0, -1.0, -1.0], [2π*m/k, 1.0, 1.0], [Nx, 1, 1], 1, 1.0, 3)
    solver = bslLD.EMSolverDKPolDensity(β, μ)
    fluid = bslLD.ColdIonFluid(grid); fluid.delta_n.data .= 1e-6 .* cos.(k .* collect(grid.xaxes[1]))
    z() = bslLD.VectorField([bslLD.ScalarField(zeros(Nx)) for _ in 1:3])
    sol = bslLD.FieldSolution(z(), z())
    quasineutral_start!(sol, fluid, grid, solver)
    amax = 0.0
    for _ in 1:round(Int, Tmax/dt)
        step(fluid, sol, grid, solver, dt)
        amax = max(amax, maximum(abs.(fluid.delta_n.data)))
        isfinite(amax) && amax < 1 || return Inf
    end
    return amax / 1e-6
end
lagged(fluid, sol, grid, solver, dt) = invoke(bslLD.step_cold!,
    Tuple{bslLD.ColdIonFluid, bslLD.FieldSolution, bslLD.Grid, bslLD.AbstractFieldSolver, Real},
    fluid, sol, grid, solver, dt)
dts_pol = [0.01, 0.02, 0.05, 0.08, 0.1, 0.12, 0.15, 0.2, 0.3]
growth = Dict(name => [cold_mode_growth(st, dt) for dt in dts_pol]
              for (name, st) in (("lagged", lagged), ("moment-implicit", bslLD.step_cold!)))

fig = Figure(size=(700, 400))
ax = Axis(fig[1,1], xlabel="Ωᵢ dt", ylabel="max|δn| / δn(0)", xscale=log10, yscale=log10,
          title="Stability of the charge-form step")
for (ci, name) in enumerate(("lagged", "moment-implicit"))
    g = growth[name]; ok = isfinite.(g)
    scatterlines!(ax, dts_pol[ok], g[ok]; color=WONG[ci+1], label=name)
    any(.!ok) && scatter!(ax, dts_pol[.!ok], fill(1e6, count(.!ok)); color=WONG[ci+1], marker=:xcross, markersize=12)
end
vlines!(ax, [0.1]; color=:gray, linestyle=:dash)
axislegend(ax; position=:lt)
fig
```

Crosses at the top mark runs that blew up (|δn| > 1).

```julia; echo=false, results="markup", label="tab-pol-dt"
ω_dt = sqrt((2/0.05) * 9 * 1.01 / (1.01 + 0.01 * (2/0.05) * 9))   # cold DKPolDensity root at kρᵢ = 3
for (dt, g) in zip(dts_pol, growth["lagged"])
    isfinite(g) && println("lagged, Ωᵢdt = $dt: growth rate ln(growth)/t = ", round(log(g)/20, sigdigits=3),
                           ",  ω²dt/4 = ", round(ω_dt^2*dt/4, sigdigits=3))
end
println("moment-implicit: bounded (max|δn|/δn(0) ≤ ", round(maximum(filter(isfinite, growth["moment-implicit"])), sigdigits=3),
        ") up to Ωᵢdt = ", maximum(dts_pol[isfinite.(growth["moment-implicit"])]))
```

The lagged form is not conditionally stable: its growth rate is $\approx\omega^2\Delta t/4$ at every $\Delta t$, a forward-Euler-type instability of the explicit ion response, so it is useless even below $1/\omega_{cap}$. The moment-implicit step stays bounded well beyond $\Omega_i\Delta t = 1/\omega_{LH}$, up to about $2/\omega_{LH}$. Beyond that the explicit defect correction (and the split gyration) no longer converge. The scheme is the implicit midpoint rule for the linear part, so unresolved $\omega_{LH}$ oscillations are not damped.
